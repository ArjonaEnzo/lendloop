    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nfunction signConvex(method, path, body) {\n  const ts = String(Math.floor(Date.now() / 1000));\n  const signature = crypto\n    .createHmac('sha256', $env.N8N_TO_LENDLOOP_SECRET)\n    .update(`${ts}.${method}.${path}.${body}`)\n    .digest('hex');\n  return { url: $env.CONVEX_SITE_URL + path, body, ts, signature };\n}\nconst e = $input.first().json;\nconst exec = e.execution || {};\nconst message = String((exec.error && exec.error.message) || 'Unknown error').slice(0, 1000);\nconst record = {\n  executionId: String(exec.id || 'trigger-' + Date.now()),\n  workflowName: String((e.workflow && e.workflow.name) || 'unknown').slice(0, 200),\n  nodeName: exec.lastNodeExecuted ? String(exec.lastNodeExecuted).slice(0, 200) : undefined,\n  message,\n};\nreturn [{ json: { ...signConvex('POST', '/api/workflow-errors', JSON.stringify(record)), record, executionUrl: exec.url || '' } }];"
      },
      "name": "Sign error record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "7ea9ff7f-bf95-461a-928a-1247b9cd85fc"
    },
