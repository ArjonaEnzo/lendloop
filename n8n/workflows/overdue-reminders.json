    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nfunction signConvex(method, path, body) {\n  const ts = String(Math.floor(Date.now() / 1000));\n  const signature = crypto\n    .createHmac('sha256', $env.N8N_TO_LENDLOOP_SECRET)\n    .update(`${ts}.${method}.${path}.${body}`)\n    .digest('hex');\n  return { url: $env.CONVEX_SITE_URL + path, body, ts, signature };\n}\nconst loanId = $('Compose reminder').item.json.loanId;\nconst today = new Date().toISOString().slice(0, 10); // UTC, same as Convex\nconst body = JSON.stringify({\n  idempotencyKey: 'reminder:' + loanId + ':' + today,\n  loanId,\n  kind: 'overdue_reminder_sent',\n  detail: 'reminder email sent',\n});\nreturn { json: signConvex('POST', '/api/automation-events', body) };",
