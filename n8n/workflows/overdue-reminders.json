    {
      "parameters": {
        "jsCode": "const l = $json;\nconst oneLine = (s) => String(s).replace(/[\\r\\n]+/g, ' ').slice(0, 120);\nconst tool = oneLine(l.toolName);\nconst days = l.daysOverdue === 1 ? '1 day' : l.daysOverdue + ' days';\nreturn {\n  json: {\n    loanId: l.loanId,\n    to: l.borrower.email,\n    subject: `[LendLoop] Reminder: please return ${tool}`,\n    text: `Hi ${oneLine(l.borrower.name || 'neighbor')},\\n\\nYour loan of ${tool} ended on ${l.endDate} (${days} ago). Please return it to the owner and let them mark it returned in LendLoop.\\n\\n— LendLoop`,\n  },\n};",
        "mode": "runOnceForEachItem"
      },
