        "jsCode": "const crypto = require('crypto');\nfunction signConvex(method, path, body) {\n  const ts = String(Math.floor(Date.now() / 1000));\n  const signature = crypto\n    .createHmac('sha256', $env.N8N_TO_LENDLOOP_SECRET)\n    .update(`${ts}.${method}.${path}.${body}`)\n    .digest('hex');\n  return { url: $env.CONVEX_SITE_URL + path, body, ts, signature };\n}\nreturn [{ json: signConvex('GET', '/api/overdue-loans', '') }];"
