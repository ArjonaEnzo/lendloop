# n8n container variables. scripts/setup-local-secrets.sh creates n8n/.env (gitignored) from this.
# Never commit real values. Generate secrets with: openssl rand -hex 32
# The two shared secrets must have the SAME value in Convex:
#   npx convex env set LENDLOOP_TO_N8N_SECRET   (value from stdin)
#   npx convex env set N8N_TO_LENDLOOP_SECRET   (value from stdin)

# Convex signs, n8n verifies (webhook).
LENDLOOP_TO_N8N_SECRET=
# n8n signs, Convex verifies (/api/* write-backs).
N8N_TO_LENDLOOP_SECRET=
# Convex HTTP actions base URL, e.g. https://<deployment>.convex.site
CONVEX_SITE_URL=
# Where the error workflow sends alerts (Mailpit catches everything locally).
OPS_EMAIL=ops@lendloop.local
# Encrypts n8n credentials at rest.
N8N_ENCRYPTION_KEY=
